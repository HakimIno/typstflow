# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust & WASM
/src-wasm/target/
/src-wasm/pkg/

# Project Temp
/.tmp/
/scratch/

# Runtime data (SQLite shares DB)
/.data/

/imageexm/*
/examples/*
!/examples/json/
!/examples/json/**
!/examples/pdf/
!/examples/pdf/**
!/examples/typst/
!/examples/typst/**
!/examples/scripts/
!/examples/scripts/**
!/examples/output/
!/examples/output/test_output.txt
