{
  "id": "unliquidated-cash-advances-demo",
  "name": "Unliquidated Cash Advances Report",
  "version": "1.0.0",
  "page": {
    "size": "A4",
    "orientation": "landscape",
    "margin": {
      "top": "15mm",
      "bottom": "15mm",
      "left": "10mm",
      "right": "10mm"
    }
  },
  "fonts": [{ "family": "Inter", "role": "body", "size": 9, "embedded": true }],
  "zones": {
    "header": { "id": "h1", "components": [], "minHeight": "20mm" },
    "footer": { "id": "f1", "components": [], "minHeight": "15mm" }
  },
  "pages": [
    {
      "id": "p1",
      "name": "Main Page",
      "body": {
        "id": "z1",
        "layoutMode": "flow",
        "components": [
          {
            "id": "title-text",
            "type": "text",
            "x": 0,
            "y": 0,
            "width": 277,
            "content": "UNLIQUIDATED CASH ADVANCES\nAs of March 31, 2019",
            "style": {
              "fontSize": 12,
              "fontWeight": "bold",
              "justify": false
            },
            "align": "center",
            "marginBottom": 5
          },
          {
            "id": "municipality-text",
            "type": "text",
            "x": 0,
            "y": 10,
            "width": 100,
            "content": "Municipality : Miagao",
            "style": { "fontSize": 10 },
            "marginBottom": 5
          },
          {
            "id": "main-table",
            "type": "table",
            "x": 0,
            "y": 20,
            "width": 277,
            "dataSource": "{{items}}",
            "groupBy": "fund",
            "groupHeaderFormat": "{{fund}}",
            "groupHeaderStyle": {
              "fontWeight": "bold",
              "background": "#f8fafc",
              "fontSize": 10,
              "align": "left"
            },
            "showHeader": true,
            "repeatHeaderOnPage": true,
            "columns": [
              { "id": "c1", "header": "Name of Debtor", "field": "debtor", "width": "50mm" },
              {
                "id": "c2",
                "header": "Amount Balance",
                "field": "balance",
                "width": "25mm",
                "align": "right"
              },
              {
                "id": "c3",
                "header": "Date Granted",
                "field": "date",
                "width": "25mm",
                "align": "center"
              },
              { "id": "c4", "header": "Purpose", "field": "purpose", "width": "40mm" },
              {
                "id": "c5",
                "header": "L30D",
                "field": "current_30",
                "width": "20mm",
                "align": "right"
              },
              {
                "id": "c6",
                "header": "31-90D",
                "field": "current_90",
                "width": "20mm",
                "align": "right"
              },
              {
                "id": "c7",
                "header": "91-365D",
                "field": "current_365",
                "width": "20mm",
                "align": "right"
              },
              {
                "id": "c8",
                "header": "O1Y",
                "field": "past_1y",
                "width": "20mm",
                "align": "right"
              },
              {
                "id": "c9",
                "header": "O2Y",
                "field": "past_2y",
                "width": "20mm",
                "align": "right"
              },
              {
                "id": "c10",
                "header": "O3Y",
                "field": "past_3y",
                "width": "20mm",
                "align": "right"
              },
              { "id": "c11", "header": "Remarks", "field": "remarks", "width": "auto" }
            ],
            "headerRows": [
              {
                "id": "hr1",
                "type": "header",
                "cells": [
                  {
                    "id": "hrc1",
                    "content": "Name of Debtor\n(In alphabetical order)",
                    "rowspan": 3,
                    "align": "center"
                  },
                  { "id": "hrc2", "content": "Amount\nBalance", "rowspan": 3, "align": "center" },
                  { "id": "hrc3", "content": "Date Granted", "rowspan": 3, "align": "center" },
                  { "id": "hrc4", "content": "Purpose", "rowspan": 3, "align": "center" },
                  { "id": "hrc5", "content": "Amount Due", "colspan": 6, "align": "center" },
                  { "id": "hrc11", "content": "Remarks", "rowspan": 3, "align": "center" }
                ]
              },
              {
                "id": "hr2",
                "type": "header",
                "cells": [
                  { "id": "hrc2_5", "content": "Current", "colspan": 3, "align": "center" },
                  { "id": "hrc2_8", "content": "Past Due", "colspan": 3, "align": "center" }
                ]
              },
              {
                "id": "hr3",
                "type": "header",
                "cells": [
                  { "id": "hrc3_5", "content": "Less than 30 days", "align": "center" },
                  { "id": "hrc3_6", "content": "31-90 days", "align": "center" },
                  { "id": "hrc3_7", "content": "91-365 days", "align": "center" },
                  { "id": "hrc3_8", "content": "Over 1 yr.", "align": "center" },
                  { "id": "hrc3_9", "content": "over 2 yrs.", "align": "center" },
                  { "id": "hrc3_10", "content": "3 yrs and above", "align": "center" }
                ]
              }
            ],
            "footerRows": [
              {
                "id": "fr1",
                "type": "footer",
                "cells": [
                  { "id": "frc1", "content": "Total", "align": "right" },
                  { "id": "frc2", "content": "{{sum(items, 'balance')}}", "align": "right" },
                  { "id": "frc3", "content": "", "colspan": 2 },
                  { "id": "frc5", "content": "{{sum(items, 'current_30')}}", "align": "right" },
                  { "id": "frc6", "content": "{{sum(items, 'current_90')}}", "align": "right" },
                  { "id": "frc7", "content": "{{sum(items, 'current_365')}}", "align": "right" },
                  { "id": "frc8", "content": "{{sum(items, 'past_1y')}}", "align": "right" },
                  { "id": "frc9", "content": "{{sum(items, 'past_2y')}}", "align": "right" },
                  { "id": "frc10", "content": "{{sum(items, 'past_3y')}}", "align": "right" },
                  { "id": "frc11", "content": "-" }
                ]
              }
            ],
            "style": {
              "headerBackground": "#f1f5f9",
              "borderWidth": "0.1mm",
              "borderColor": "#94a3b8",
              "inset": "1.5mm",
              "fontSize": 8
            }
          }
        ]
      }
    }
  ],
  "groups": [],
  "variables": [],
  "dataSchema": [],
  "metadata": {
    "title": "Unliquidated Cash Advances",
    "createdAt": "2024-05-12T00:00:00Z",
    "updatedAt": "2024-05-12T00:00:00Z",
    "author": "TypstFlow Agent"
  }
}
